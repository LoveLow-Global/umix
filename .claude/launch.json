{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "umix",
      "runtimeExecutable": "julia",
      "runtimeArgs": ["--threads=1,1", "--project=backend", "backend/bin/serve.jl", "--port", "8080"],
      "port": 8080
    },
    {
      "name": "umix-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8090", "--directory", "frontend"],
      "port": 8090
    },
    {
      "name": "webpage",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "webpage", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
